{
    "name": "nvl/pages",
    "description": "Hierarchical, translatable, content-composed pages and dynamic page resources for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "pages",
        "cms",
        "content",
        "seo",
        "sitemap",
        "translations"
    ],
    "require": {
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nesbot/carbon": "^3.8",
        "nvl/core": "^7.0",
        "nvl/translatable": "^7.0",
        "php": "^8.4",
        "symfony/http-kernel": "^7.2 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/media": "^7.0",
        "nvl/metafields": "^7.0",
        "nvl/ownership": "^7.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "nvl/content": "^7.0",
        "nvl/seo": "^7.0",
        "nvl/filterable": "^7.0",
        "spatie/laravel-data": "^4.23"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Pages\\": "src/",
            "Nvl\\Pages\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Pages\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "7.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Pages\\Providers\\PagesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep",
            ".DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/metafields": "Adds optional Page metafield relationships for consumer-owned composition.",
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts.",
        "nvl/content": "Enables explicitly selected Page content composition.",
        "nvl/seo": "Enables explicitly selected SEO profiles and sitemaps."
    },
    "conflict": {
        "nvl/content": "<7.0 || >=8.0",
        "nvl/metafields": "<7.0 || >=8.0",
        "nvl/ownership": "<7.0 || >=8.0",
        "nvl/seo": "<7.0 || >=8.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/pages",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/pages",
        "docs": "https://github.com/nvl-laravel-suite/pages#readme",
        "issues": "https://github.com/nvl-laravel-suite/pages/issues",
        "security": "https://github.com/nvl-laravel-suite/pages/security/policy"
    }
}
